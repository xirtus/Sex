#![no_std]
#![no_main]

use sex_pdx::{pdx_listen_raw, serial_println, SLOT_BELL};

#[panic_handler]
fn panic(_: &core::panic::PanicInfo) -> ! {
    loop {}
}

#[no_mangle]
pub extern "C" fn _start() -> ! {
    serial_println!("[bell.boot]");

    loop {
        let msg = pdx_listen_raw(0);

        unsafe {
            static mut BELL_UNKNOWN_BUDGET: u32 = 8;
            let b = &mut BELL_UNKNOWN_BUDGET;
            if *b > 0 {
                *b -= 1;
                serial_println!("[bell.unknown.reject] slot={} type_id={:#x}", SLOT_BELL, msg.type_id);
            }
        }
    }
}
