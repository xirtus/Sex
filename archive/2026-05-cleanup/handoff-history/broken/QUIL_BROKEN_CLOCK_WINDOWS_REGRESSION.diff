+                            serial_println!("[app.crashrestore.proof.scheduler_alive] ok=1 linen={} mesh={} loop_continues={}",
+                                linen_alive as u8, mesh_alive as u8, 1u8);
+                        }
+                        4 => {
+                            // [app.crashrestore.proof.relaunch]
+                            // Relaunch Quil: re-register lifecycle, reactivate surface.
+                            let sid = SURFACE_ID_QUIL;
+                            // Re-register (clear tombstone state for new lifecycle).
+                            lifecycle_register(sid, LifecycleState::Visible);
+                            // Reactivate on display.
+                            pdx_call(SLOT_DISPLAY, OP_SURFACE_UPDATE, sid,
+                                (QUIL_BOOT_Y as u64) | ((QUIL_BOOT_X as u64) << 32),
+                                (QUIL_BOOT_W as u64) | ((QUIL_BOOT_H as u64) << 32));
