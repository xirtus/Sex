+                }
+            }
+            Err(e) => {
+                serial_println!("[sexobject.m9.pass] ok=0 reason=create_failed err={}", e);
+                return;
+            }
+        }
+    }
+
+    // ── Stage 1: Local session_id ≠ global object_id ──
+    {
+        let separate = local_session_id != global_oid;
+        serial_println!(
+            "[sexobject.m9.spindle.local_id_separate] session_id={} global_id={} separate={}",
+            local_session_id, global_oid, separate as u8
+        );
+    }
+
+    // ── Stage 2: SexObjectRef uses global ID ──
+    {
+        use crate::sexobject::linen_object_ref;
+        if let Ok(obj) = SESSION.get(local_session_id, 0) {
+            let sex_ref = linen_object_ref(&obj);
+            let global_in_ref = sex_ref.object_id == global_oid
+                             && sex_ref.object_id != local_session_id;
+            serial_println!(
+                "[sexobject.m9.spindle.ref_global] ref_object_id={} global_in_ref={}",
+                sex_ref.object_id, global_in_ref as u8
+            );
+
+            let local_leaked = sex_ref.object_id == local_session_id;
+            serial_println!(
+                "[sexobject.m9.spindle.local_id_reject] local_leaked={}",
+                local_leaked as u8
+            );
+        } else {
+            serial_println!("[sexobject.m9.spindle.ref_global] get_failed");
+            serial_println!("[sexobject.m9.spindle.local_id_reject] get_failed");
+        }
+    }
+
+    serial_println!("[sexobject.m9.pass] ok=1");
+    serial_println!("[linen.m9.proof] end");
+}
