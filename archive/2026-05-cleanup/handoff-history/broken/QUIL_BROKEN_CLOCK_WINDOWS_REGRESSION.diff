+    let pixels: usize = 1280 * 800;
+    let bytes: u64 = (pixels as u64).checked_mul(4).unwrap_or(0);
+    let end_addr = fb_addr.checked_add(bytes);
+    let ok_end = end_addr.is_some();
+
+    let all_ok = ok_null && ok_zero_w && ok_bounds && ok_max_w && ok_end;
+    serial_println!(
