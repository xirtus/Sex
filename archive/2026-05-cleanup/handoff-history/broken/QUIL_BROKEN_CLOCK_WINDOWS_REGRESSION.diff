+
+    // Test 3: w * h overflow → rejected
+    let w_big: usize = MAX_FB_W;
+    let h_big: usize = MAX_FB_H;
+    let ok_bounds = w_big.checked_mul(h_big).is_some(); // within bounds
+
+    // Test 4: w > MAX_FB_W → rejected
+    let ok_max_w = (MAX_FB_W + 1) > MAX_FB_W;
+
+    // Test 5: end_addr overflow check
