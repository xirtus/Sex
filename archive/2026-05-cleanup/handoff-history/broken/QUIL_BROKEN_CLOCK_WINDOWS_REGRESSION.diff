+fn handle_edit_key(scancode: u64) -> bool {
+    unsafe {
+        match scancode as u8 {
+            0x4B => {
+                if QUIL_EDIT_CURSOR > 0 {
+                    QUIL_EDIT_CURSOR -= 1;
+                }
+                clamp_cursor();
+                render_edit_buffer();
+                true
+            }
+            0x4D => {
+                if QUIL_EDIT_CURSOR < QUIL_EDIT_LEN {
+                    QUIL_EDIT_CURSOR += 1;
+                }
+                clamp_cursor();
+                render_edit_buffer();
+                true
+            }
+            0x0E => {
+                if QUIL_EDIT_CURSOR > 0 && QUIL_EDIT_LEN > 0 {
+                    let del = QUIL_EDIT_CURSOR - 1;
+                    let mut i = del;
+                    while i + 1 < QUIL_EDIT_LEN {
+                        QUIL_EDIT_BUF[i] = QUIL_EDIT_BUF[i + 1];
+                        i += 1;
+                    }
+                    QUIL_EDIT_LEN -= 1;
+                    QUIL_EDIT_CURSOR -= 1;
+                    serial_println!("[quil.buffer.backspace.v1] len={}", QUIL_EDIT_LEN);
+                    clamp_cursor();
+                    render_edit_buffer();
+                }
+                true
+            }
+            0x1C => {
+                if QUIL_EDIT_LEN < QUIL_EDIT_TEXT_MAX {
+                    let mut i = QUIL_EDIT_LEN;
+                    while i > QUIL_EDIT_CURSOR {
+                        QUIL_EDIT_BUF[i] = QUIL_EDIT_BUF[i - 1];
+                        i -= 1;
+                    }
+                    QUIL_EDIT_BUF[QUIL_EDIT_CURSOR] = b'\n';
+                    QUIL_EDIT_LEN += 1;
+                    QUIL_EDIT_CURSOR += 1;
+                    serial_println!("[quil.buffer.insert.v1] kind=newline len={}", QUIL_EDIT_LEN);
+                    clamp_cursor();
+                    render_edit_buffer();
+                }
+                true
+            }
+            _ => {
+                if let Some(ch) = scancode_to_ascii(scancode) {
+                    if QUIL_EDIT_LEN < QUIL_EDIT_TEXT_MAX {
+                        let mut i = QUIL_EDIT_LEN;
+                        while i > QUIL_EDIT_CURSOR {
+                            QUIL_EDIT_BUF[i] = QUIL_EDIT_BUF[i - 1];
+                            i -= 1;
+                        }
+                        QUIL_EDIT_BUF[QUIL_EDIT_CURSOR] = ch;
+                        QUIL_EDIT_LEN += 1;
+                        QUIL_EDIT_CURSOR += 1;
+                        serial_println!("[quil.buffer.insert.v1] ch={} len={}", ch as u64, QUIL_EDIT_LEN);
+                        clamp_cursor();
+                        render_edit_buffer();
+                    }
+                    true
+                } else {
+                    false
+                }
+            }
+        }
+    }
 }
 
