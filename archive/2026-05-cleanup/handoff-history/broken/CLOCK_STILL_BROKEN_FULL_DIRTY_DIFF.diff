+                        let _ = SESSION.set_sexfiles_object_id(local_id, soid);
+                        global_oid = soid;
+                    }
+                    Err(e) => {
+                        serial_println!("[sexobject.m7.pass] ok=0 reason=persist_failed err={}", e);
+                        return;
+                    }
+                }
+            }
+            Err(e) => {
+                serial_println!("[sexobject.m7.pass] ok=0 reason=create_failed err={}", e);
+                return;
+            }
+        }
+    }
+
+    // ── Stage 1: Record Mesh-style fact using global SexFiles object_id ──
+    {
+        // Simulate a Mesh fact write.  In the real Mesh, this would be
+        // mesh_record_fact(kind, subject_id, object_id, ref_id).
+        // Here we prove the IDs are correct.
+        let fact_subject_id = global_oid;       // authoritative SexObject identity
+        let fact_object_id = global_oid;         // self-referential for V1
+        let fact_ref_id = local_id;              // Linen-local id as debug ref only
+
+        // [sexobject.m7.mesh.fact.write]
+        serial_println!(
+            "[sexobject.m7.mesh.fact.write] subject_id={} object_id={} ref_id={} sequence={}",
+            fact_subject_id, fact_object_id, fact_ref_id, 1u64
+        );
+
+        // [sexobject.m7.mesh.global_id]
+        // Prove the global SexFiles ID is used in the fact subject_id.
+        let global_used = fact_subject_id == global_oid && global_oid > 0;
+        serial_println!(
+            "[sexobject.m7.mesh.global_id] local_id={} global_id={} global_used={}",
+            local_id, global_oid, global_used as u8
+        );
+
+        // [sexobject.m7.mesh.local_id_reject]
+        // Prove Linen-local ID did NOT leak into subject_id/object_id.
+        let local_in_subject = fact_subject_id == local_id;
+        let local_in_object = fact_object_id == local_id;
+        let local_leaked = local_in_subject || local_in_object;
+        serial_println!(
+            "[sexobject.m7.mesh.local_id_reject] local_leaked={}",
+            local_leaked as u8
+        );
+    }
