+                    event_id, global_oid, global_gen
+                );
+            }
+            Err(reason) => {
+                serial_println!("[sexobject.m8.pass] ok=0 reason=queue_push_failed err={}", reason);
+                return;
+            }
+        }
+    }
+
+    // ── Stage 1: Verify global ID stored, event_id is separate ──
+    {
+        let idx = unsafe {
+            (BELL_QUEUE.tail as usize + BELL_QUEUE_CAPACITY - 1) % BELL_QUEUE_CAPACITY
+        };
+        let entry = unsafe { &BELL_QUEUE.entries[idx] };
+
+        let global_used = entry.sexfiles_object_id == global_oid
+                       && entry.sexfiles_object_id > 0
+                       && entry.event_id != global_oid;
+        serial_println!(
+            "[sexobject.m8.bell.global_id] local_id={} global_id={} event_id={} global_used={}",
+            local_id, entry.sexfiles_object_id, entry.event_id, global_used as u8
+        );
+
+        let local_leaked = entry.sexfiles_object_id == local_id;
+        serial_println!(
+            "[sexobject.m8.bell.local_id_reject] local_leaked={}",
+            local_leaked as u8
+        );
+    }
+
+    // ── Stage 2: Bell is observable only ──
+    {
+        serial_println!(
+            "[sexobject.m8.bell.observable_only] authority_enforced=0 storage_mutated=0"
+        );
+    }
+
+    serial_println!("[sexobject.m8.pass] ok=1");
+    serial_println!("[bell.m8.proof] end");
+}
