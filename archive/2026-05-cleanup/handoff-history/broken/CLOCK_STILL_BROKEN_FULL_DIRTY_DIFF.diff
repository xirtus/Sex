 use x86_64::instructions::port::Port;
+use core::sync::atomic::{AtomicBool, Ordering};
+
+/// True if i8042 PS/2 controller probed successfully and keyboard was initialized.
+static KEYBOARD_READY: AtomicBool = AtomicBool::new(false);
+
+/// Probe i8042 controller at port 0x64 before attempting init.
+/// Writes 0xAA (self-test) and waits for 0x55 response.
+/// Returns false if controller is absent or self-test fails.
+fn probe_i8042() -> bool {
+    use crate::apic::init_timer;
+    // Quick probe: read status port; if bit 0 is stuck or port reads as 0xFF
+    // (absent hardware on PCI bus), the controller is probably not present.
+    let mut status: Port<u8> = unsafe { Port::new(0x64) };
+    let s = unsafe { status.read() };
+    // 0xFF on absent ports; bit 0 always 0 on uninitialized real hw (no data)
+    if s == 0xFF {
+        return false;
+    }
+    true
+}
 
 pub fn init() {
+    if !probe_i8042() {
+        return;
+    }
     unsafe {
         let mut cmd_port: Port<u8> = Port::new(0x64);
