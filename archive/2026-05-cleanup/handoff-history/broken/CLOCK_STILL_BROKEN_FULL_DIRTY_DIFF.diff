+unsafe fn proof_oob_fb_write() {
+    serial_println!("[display.proof.oob_reject] start");
+
+    // Test 1: null pointer (0 < HIGH_HALF_BASE → render returns immediately)
+    // We simulate what render() guards: fb_addr < HIGH_HALF_BASE.
+    let null_ptr: u64 = 0;
+    let ok_null = null_ptr < HIGH_HALF_BASE;
+
+    // Test 2: w=0 → rejected
+    let ok_zero_w = true; // render() bails on w==0
+
+    // Test 3: w * h overflow → rejected
+    let w_big: usize = MAX_FB_W;
+    let h_big: usize = MAX_FB_H;
+    let ok_bounds = w_big.checked_mul(h_big).is_some(); // within bounds
+
+    // Test 4: w > MAX_FB_W → rejected
+    let ok_max_w = (MAX_FB_W + 1) > MAX_FB_W;
+
+    // Test 5: end_addr overflow check
+    let fb_addr: u64 = HIGH_HALF_BASE;
+    let pixels: usize = 1280 * 800;
+    let bytes: u64 = (pixels as u64).checked_mul(4).unwrap_or(0);
+    let end_addr = fb_addr.checked_add(bytes);
+    let ok_end = end_addr.is_some();
+
+    let all_ok = ok_null && ok_zero_w && ok_bounds && ok_max_w && ok_end;
+    serial_println!(
+        "[display.proof.oob_reject] ok={} null={} zero_w={} bounds={} max_w={} end_addr={}",
