+        serial_println!(
+            "[sexobject.m7.mesh.observable_only] authority_enforced=0 storage_mutated=0"
+        );
+    }
+
+    serial_println!("[sexobject.m7.pass] ok=1");
+    serial_println!("[linen.m7.proof] end");
